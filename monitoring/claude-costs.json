    {
      "id": 6,
      "type": "stat",
      "title": "5-hour window used",
      "description": "What Claude Code reports of your plan's allowance, sent by the status line (COST_MONITORING.md, Your plan's allowance). Orange from 80 %, red from 100 %.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "((max(last_over_time(qf_plan_used_percent{window=\"five_hour\"}[7d])) and on() (max(last_over_time(qf_plan_resets_at{window=\"five_hour\"}[7d])) > time())) or on() (max(last_over_time(qf_plan_resets_at{window=\"five_hour\"}[7d])) <= time()) * 0)",
          "legendFormat": "used",
          "refId": "A",
          "instant": true,
          "range": false,
          "format": "time_series"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max(last_over_time(qf_plan_resets_at{window=\"five_hour\"}[7d])) * 1000",
          "legendFormat": "resets",
          "refId": "B",
          "instant": true,
          "range": false,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 80
              },
              {
                "color": "red",
                "value": 100
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "B"
            },
            "properties": [
              {
                "id": "unit",
                "value": "dateTimeFromNow"
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "text"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
